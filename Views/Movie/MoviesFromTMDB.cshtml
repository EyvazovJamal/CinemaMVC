
@if (ViewData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-center" role="alert">
        @ViewData["ErrorMessage"]
    </div>
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
@model List<Cinema.Api.Response.MovieApiResponse>

@{
    ViewData["Title"] = "Популярные фильмы";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold text-primary">Популярные фильмы из TMDB</h1>
        <span class="badge bg-secondary fs-6">Найдено: @Model.Count</span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center" role="alert">
            Фильмы не найдены. Проверьте подключение к микросервису MovieApi.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var movie in Model)
            {
                // Формируем полную ссылку на постер TMDB
                var posterUrl = string.IsNullOrEmpty(movie.PosterPath) 
                    ? "https://placehold.co/500x750?text=No+Poster" 
                    : $"https://image.tmdb.org/t/p/w500{movie.PosterPath}";
                
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 transition-hover">
                        <div class="position-absolute top-0 end-0 m-2">
                            <span class="badge bg-warning text-dark fw-bold fs-6 shadow">
                                ⭐ @movie.VoteAverage.ToString("0.0")
                            </span>
                        </div>
                        
                        <img src="@posterUrl" class="card-img-top rounded-top" alt="@movie.Title" style="object-fit: cover; height: 380px;">
                        
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark text-truncate" title="@movie.Title">
                                @movie.Title
                            </h5>
                            
                            <h6 class="card-subtitle mb-2 text-muted fst-italic text-truncate">
                                @movie.OriginalTitle (@movie.OriginalLanguage.ToUpper())
                            </h6>
                            
                            <p class="card-text text-muted small flex-grow-1 text-overflow-3">
                                @(string.IsNullOrEmpty(movie.Overview) ? "Описание отсутствует." : movie.Overview)
                            </p>
                            
                            <div class="mb-3 mt-2">
                                <small class="text-muted d-block">
                                    📅 Релиз: @(movie.ReleaseDate?.ToString("dd MMMM yyyy") ?? "Неизвестно")
                                </small>
                                <small class="text-muted d-block">
                                    👥 Голосов: @movie.VoteCount
                                </small>
                            </div>
                            
                            <form asp-controller="Movie" asp-action="AddToCinema" method="post" class="mt-auto ajax-form">
                                <input type="hidden" name="movieId" value="@movie.Id" />
                                <button type="submit" class="btn btn-outline-primary w-100 fw-semibold shadow-sm">
                                    ➕ Добавить в прокат
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .transition-hover {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .transition-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
    }
    /* Обрезаем текст описания до 3 строк, чтобы карточки были одной высоты */
    .text-overflow-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;  
        overflow: hidden;
    }
</style>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.querySelectorAll('.ajax-form').forEach(form => {
            form.addEventListener('submit', async function (e) {
                e.preventDefault(); 

                const formData = new FormData(this);
                const button = this.querySelector('button');
                
                button.disabled = true;
                const originalText = button.innerHTML;
                button.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Добавление...';

                try {
                    const response = await fetch(this.action, {
                        method: 'POST',
                        body: formData
                    });

                    // КРИТИЧЕСКИЙ МОМЕНТ: Если статус не 200-299 (например, 415 или 500)
                    if (!response.ok) {
                        throw new Error(`Ошибка сервера: ${response.status}`);
                    }

                    // Если сервер ответил 200 OK, читаем JSON
                    const result = await response.json();
                    
                    // Проверяем флаг success, который прислал наш контроллер
                    if (result.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Готово!',
                            text: result.message,
                            timer: 2500,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end'
                        });

                        button.className = "btn btn-success w-100 fw-semibold disabled";
                        button.innerHTML = "✓ В прокате";
                    } else {
                        // Если контроллер сам вернул success = false
                        throw new Error(result.message || 'Что-то пошло не так внутри контроллера');
                    }

                } catch (error) {
                    console.error(error); // Выводим ошибку в консоль браузера для отладки

                    Swal.fire({
                        icon: 'error',
                        title: 'Упс...',
                        text: error.message || 'Не удалось добавить фильм в прокат.',
                        toast: true,
                        position: 'top-end',
                        timer: 4000,
                        showConfirmButton: false
                    });
                    
                    // Возвращаем кнопку в рабочее состояние, чтобы юзер мог попробовать еще раз
                    button.disabled = false;
                    button.innerHTML = originalText;
                }
            });
        });
    </script>
}