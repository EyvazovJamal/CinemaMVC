@model Cinema.Models.ScheduleViewModel
@{
    ViewData["Title"] = "Расписание сеансов";
    var dayStartHour = Model.DayStartHour;
    var dayEndHour = Model.DayEndHour;
    var totalMinutes = (dayEndHour - dayStartHour) * 60;

    double TimeToPercent(DateTimeOffset time)
    {
        var minutes = time.Hour * 60 + time.Minute;
        var startMinutes = dayStartHour * 60;
        return Math.Clamp((minutes - startMinutes) * 100.0 / totalMinutes, 0, 100);
    }

    double DurationToPercent(int runtime, int buffer) =>
        Math.Clamp((runtime + buffer) * 100.0 / totalMinutes, 0, 100);

    string FormatTime(DateTimeOffset time) => time.ToString("HH:mm");
}

<link rel="stylesheet" href="~/css/schedule.css" asp-append-version="true" />

<div class="schedule-page" style="--day-start-hour: @dayStartHour; --day-end-hour: @dayEndHour; --hour-count: @(dayEndHour - dayStartHour);">
    <div class="schedule-toolbar d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Расписание залов</h1>
            <p class="text-muted mb-0">Планируйте сеансы — система сама предложит время</p>
        </div>
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <button type="button"
                    id="repeat-yesterday-btn"
                    class="btn btn-outline-secondary d-flex align-items-center gap-2"
                    title="Скопировать все сеансы с предыдущего дня на выбранную дату">
                <i class="bi bi-arrow-repeat"></i> Повторить вчерашние сеансы
            </button>

            <!-- Кнопка добавления зала, доступная всегда -->
            <button type="button" class="btn btn-outline-primary d-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#createHallModal">
                <i class="bi bi-plus-circle"></i> Добавить зал
            </button>

            <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
                <label for="date" class="form-label mb-0 text-muted">Дата:</label>
                <input type="date" id="date" name="date" class="form-control"
                       value="@Model.Date.ToString("yyyy-MM-dd")"
                       onchange="this.form.submit()" />
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger mt-3">@Model.ErrorMessage</div>
    }
    else if (!Model.Halls.Any())
    {
        <div class="alert alert-warning mt-3 d-flex justify-content-between align-items-center">
            <div>
                Залы не найдены. Вы можете создать зал прямо сейчас или использовать MovieApi (<code>POST /api/hall/create</code>).
            </div>
        </div>
    }
    else
    {
        <div class="schedule-board mt-3">
            <div class="schedule-grid">
                <div class="schedule-time-header">
                    <div class="schedule-corner"></div>
                    @for (var hour = dayStartHour; hour < dayEndHour; hour++)
                    {
                        <div class="schedule-hour">@($"{hour:00}:00")</div>
                    }
                </div>

                @foreach (var hall in Model.Halls)
                {
                    var hallScreenings = Model.GetScreeningsForHall(hall.Id).ToList();
                    var addButtonLeft = hallScreenings.Count == 0
                        ? 0.5
                        : TimeToPercent(hallScreenings.Last().EndTime.AddMinutes(hallScreenings.Last().BufferMinutes));

                    <div class="schedule-row">
                        <div class="schedule-hall-label">@hall.Name</div>
                        <div class="schedule-track" data-hall-id="@hall.Id" data-hall-name="@hall.Name">
                            @foreach (var screening in hallScreenings)
                            {
                                var left = TimeToPercent(screening.StartTime);
                                var width = DurationToPercent(screening.Runtime, screening.BufferMinutes);

                                <div class="screening-block"
                                     style="left: @left.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%; width: @width.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%;"
                                     title="@screening.MovieTitle: @FormatTime(screening.StartTime) – @FormatTime(screening.EndTime)">
                                    @screening.MovieTitle
                                    <small>@FormatTime(screening.StartTime)</small>
                                    <button type="button" class="delete-screening-btn" data-id="@screening.Id" title="Удалить">×</button>
                                </div>
                            }

                            <button type="button"
                                    class="add-screening-btn"
                                    style="left: @addButtonLeft.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%;"
                                    title="Добавить сеанс"
                                    data-hall-id="@hall.Id"
                                    data-hall-name="@hall.Name">
                                +
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="schedule-legend">
            <span><span class="legend-block"></span> Сеанс (длительность + 10 мин буфер)</span>
            <span><strong>+</strong> — добавить следующий сеанс в зале</span>
        </div>
    }
</div>

<!-- Модальное окно: Новый сеанс -->
<div class="modal fade" id="createScreeningModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Новый сеанс</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label text-muted">Зал</label>
                    <input type="text" class="form-control" id="modal-hall-name" readonly />
                    <input type="hidden" id="modal-hall-id" />
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted">Начало сеанса</label>
                    <input type="text" class="form-control" id="modal-start-time" readonly />
                    <input type="hidden" id="modal-start-time-value" />
                </div>
                <div class="mb-3">
                    <label for="modal-movie-id" class="form-label">Фильм</label>
                    <select class="form-select" id="modal-movie-id">
                        <option value="">— выберите фильм —</option>
                        @foreach (var movie in Model.Movies)
                        {
                            <option value="@movie.id" data-runtime="@movie.runtime">
                                @movie.title (@movie.runtime мин)
                            </option>
                        }
                    </select>
                </div>
                <div id="modal-end-preview" class="text-muted small"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary" id="modal-confirm-btn">Добавить сеанс</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно: Добавить зал (Через HTML Form) -->
<div class="modal fade" id="createHallModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Добавление нового зала</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- Форма отправляет данные напрямую на ваш эндпоинт -->
            <form action="/hall/create" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="hall-name" class="form-label">Название зала</label>
                        <!-- Атрибут name должен строго совпадать с параметром 'string name' в контроллере -->
                        <input type="text" class="form-control" id="hall-name" name="name" placeholder="Например: Синий зал, VIP" required />
                    </div>
                    <div class="mb-3">
                        <label for="hall-capacity" class="form-label">Количество мест (сидений)</label>
                        <!-- Атрибут name должен строго совпадать с параметром 'int seats' в контроллере -->
                        <input type="number" class="form-control" id="hall-capacity" name="seats" min="1" placeholder="Например: 50" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-success">Создать зал</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const scheduleDate = '@Model.Date.ToString("yyyy-MM-dd")';
        const cinemaTimeZone = '@Model.TimeZoneId';

        function formatTime(isoString) {
            return new Date(isoString).toLocaleTimeString('ru-RU', {
                hour: '2-digit',
                minute: '2-digit',
                hour12: false,
                timeZone: cinemaTimeZone
            });
        }

        function updateEndPreview() {
            const select = document.getElementById('modal-movie-id');
            const startValue = document.getElementById('modal-start-time-value').value;
            const preview = document.getElementById('modal-end-preview');

            if (!select.value || !startValue) {
                preview.textContent = '';
                return;
            }

            const runtime = parseInt(select.selectedOptions[0].dataset.runtime, 10);
            const start = new Date(startValue);
            const end = new Date(start.getTime() + runtime * 60000);
            const occupied = new Date(end.getTime() + 10 * 60000);

            preview.textContent =
                `Окончание: ${formatTime(end.toISOString())} (+ 10 мин буфер до ${formatTime(occupied.toISOString())})`;
        }

        function formatDateRu(isoDate) {
            const [year, month, day] = isoDate.split('-');
            return `${day}.${month}.${year}`;
        }

        async function loadRepeatPreview() {
            const btn = document.getElementById('repeat-yesterday-btn');
            if (!btn) {
                return null;
            }

            try {
                const response = await fetch(`/schedule/repeat-preview?date=${scheduleDate}`);
                const result = await response.json();

                if (!result.success) {
                    btn.disabled = true;
                    btn.title = result.message || 'Не удалось проверить возможность копирования';
                    return null;
                }

                const preview = result.data;
                if (!preview.canRepeat) {
                    btn.disabled = true;
                    if (preview.targetHasScreenings) {
                        btn.title = 'На выбранную дату уже есть сеансы';
                    } else if (preview.sourceScreeningCount === 0) {
                        btn.title = `На ${formatDateRu(preview.sourceDate)} не было сеансов`;
                    } else {
                        btn.title = 'Копирование недоступно';
                    }
                } else {
                    btn.disabled = false;
                    btn.title = `Скопировать ${preview.sourceScreeningCount} сеансов с ${formatDateRu(preview.sourceDate)}`;
                }

                return preview;
            } catch {
                btn.disabled = true;
                btn.title = 'Не удалось проверить возможность копирования';
                return null;
            }
        }

        document.getElementById('repeat-yesterday-btn')?.addEventListener('click', async () => {
            const btn = document.getElementById('repeat-yesterday-btn');
            const preview = await loadRepeatPreview();

            if (!preview?.canRepeat) {
                Swal.fire({
                    icon: 'info',
                    title: 'Копирование недоступно',
                    text: btn.title,
                    toast: true,
                    position: 'top-end',
                    timer: 4000,
                    showConfirmButton: false
                });
                return;
            }

            const confirmed = await Swal.fire({
                icon: 'question',
                title: 'Повторить вчерашние сеансы?',
                html: `Будет скопировано <strong>${preview.sourceScreeningCount}</strong> сеансов<br>` +
                    `с <strong>${formatDateRu(preview.sourceDate)}</strong> на <strong>${formatDateRu(preview.targetDate)}</strong>`,
                showCancelButton: true,
                confirmButtonText: 'Скопировать',
                cancelButtonText: 'Отмена'
            });

            if (!confirmed.isConfirmed) {
                return;
            }

            btn.disabled = true;

            const formData = new FormData();
            formData.append('date', scheduleDate);

            try {
                const response = await fetch('/schedule/repeat-yesterday', { method: 'POST', body: formData });
                const result = await response.json();

                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Не удалось скопировать сеансы');
                }

                Swal.fire({
                    icon: 'success',
                    title: 'Готово!',
                    text: result.message,
                    timer: 2500,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                }).then(() => window.location.reload());
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Ошибка',
                    text: error.message,
                    toast: true,
                    position: 'top-end',
                    timer: 4000,
                    showConfirmButton: false
                });
                await loadRepeatPreview();
            }
        });

        loadRepeatPreview();

        document.querySelectorAll('.add-screening-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const hallId = btn.dataset.hallId;
                const hallName = btn.dataset.hallName;

                try {
                    const response = await fetch(
                        `/schedule/next-slot?hallId=${hallId}&date=${scheduleDate}`);
                    const result = await response.json();

                    if (!result.success) {
                        throw new Error(result.message || 'Не удалось получить время');
                    }

                    const slot = result.data;
                    document.getElementById('modal-hall-id').value = hallId;
                    document.getElementById('modal-hall-name').value = hallName;
                    document.getElementById('modal-start-time-value').value = slot.suggestedStartTime;
                    document.getElementById('modal-start-time').value = formatTime(slot.suggestedStartTime);
                    document.getElementById('modal-movie-id').value = '';
                    document.getElementById('modal-end-preview').textContent = '';

                    new bootstrap.Modal(document.getElementById('createScreeningModal')).show();
                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Ошибка',
                        text: error.message || 'Не удалось подготовить сеанс',
                        toast: true,
                        position: 'top-end',
                        timer: 4000,
                        showConfirmButton: false
                    });
                }
            });
        });

        document.getElementById('modal-movie-id').addEventListener('change', updateEndPreview);

        document.getElementById('modal-confirm-btn').addEventListener('click', async () => {
            const movieId = document.getElementById('modal-movie-id').value;
            const hallId = document.getElementById('modal-hall-id').value;
            const startTime = document.getElementById('modal-start-time-value').value;

            if (!movieId) {
                Swal.fire({ icon: 'warning', title: 'Выберите фильм', toast: true, position: 'top-end', timer: 2500, showConfirmButton: false });
                return;
            }

            const btn = document.getElementById('modal-confirm-btn');
            btn.disabled = true;

            const formData = new FormData();
            formData.append('movieId', movieId);
            formData.append('hallId', hallId);
            formData.append('startTime', startTime);

            try {
                const response = await fetch('/schedule/create', { method: 'POST', body: formData });
                const result = await response.json();

                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Не удалось создать сеанс');
                }

                bootstrap.Modal.getInstance(document.getElementById('createScreeningModal')).hide();

                Swal.fire({
                    icon: 'success',
                    title: 'Готово!',
                    text: result.message,
                    timer: 2000,
                    showConfirmButton: false,
                    toast: true,
                    position: 'top-end'
                }).then(() => window.location.reload());
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Упс...',
                    text: error.message,
                    toast: true,
                    position: 'top-end',
                    timer: 4000,
                    showConfirmButton: false
                });
            } finally {
                btn.disabled = false;
            }
        });
        document.querySelectorAll('.delete-screening-btn').forEach(btn => {
            btn.addEventListener('click', async (event) => {
                event.stopPropagation();
                const id = btn.dataset.id;
                if (!id) {
                    return;
                }
                const formData = new FormData();
                formData.append('id', id);
                try {
                    const response = await fetch('/schedule/delete', {
                        method: 'POST',
                        body: formData
                    });
                    if (!response.ok) {
                        throw new Error('Не удалось удалить сеанс');
                    }
                    window.location.reload();
                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Ошибка',
                        text: error.message || 'Не удалось удалить сеанс',
                        toast: true,
                        position: 'top-end',
                        timer: 4000,
                        showConfirmButton: false
                    });
                }
            });
        });
    </script>
}