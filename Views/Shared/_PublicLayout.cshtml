<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StepCinema</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Cinema.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="public-body d-flex flex-column min-vh-100">
@{
    var path = Context.Request.Path.Value ?? "";
    var isAfisha = path.Equals("/afisha", StringComparison.OrdinalIgnoreCase)
                   || path.StartsWith("/movie/", StringComparison.OrdinalIgnoreCase);
    var isToday = path.Equals("/today", StringComparison.OrdinalIgnoreCase);
}

    <header class="public-header">
        <nav class="navbar navbar-expand-md navbar-dark">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/afisha">
                    <span class="brand-icon">🍿</span> StepCinema
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                        data-bs-target="#publicNav" aria-controls="publicNav"
                        aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="publicNav">
                    <ul class="navbar-nav ms-auto align-items-md-center gap-md-1">
                        <li class="nav-item">
                            <a class="nav-link @(isAfisha ? "active" : "")" href="/afisha">
                                <i class="bi bi-film me-1"></i> Афиша
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(isToday ? "active" : "")" href="/today">
                                <i class="bi bi-calendar-event me-1"></i> Сегодня
                            </a>
                        </li>
                        <li class="nav-item ms-md-2">
                            <a class="btn btn-outline-warning btn-sm public-admin-btn" href="/schedule">
                                <i class="bi bi-gear me-1"></i> Админ
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="public-main flex-grow-1">
        @RenderBody()
    </main>

    <footer class="public-footer mt-auto">
        <div class="container py-4">
            <div class="row align-items-center justify-content-between text-center text-md-start g-3">
                <div class="col-md-6">
                    <span class="text-white-50">&copy; 2026 <strong class="text-white">StepCinema</strong></span>
                </div>
                <div class="col-md-6 text-md-end">
                    <a class="text-white-50 text-decoration-none me-3" href="/Home/Privacy">
                        Конфиденциальность
                    </a>
                    <span class="text-white-50">Билеты онлайн</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
