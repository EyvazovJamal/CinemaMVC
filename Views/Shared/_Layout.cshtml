<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StepCinema</title>
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Cinema.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom border-secondary box-shadow mb-4 py-3">
            <div class="container">
                <a class="navbar-brand fw-bold fs-4 text-warning" asp-area="" asp-controller="Movie" asp-action="MoviesFromTMDB">
                    🍿 StepCinema
                </a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-3">
                        <li class="nav-item">
                            <a class="nav-link text-light-50"
                               asp-controller="Home"
                               asp-action="Index">
                                Главная
                            </a>                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link active fw-semibold text-white" asp-area="" asp-controller="Movie" asp-action="MoviesFromTMDB">
                                <i class="bi bi-fire text-danger me-1"></i> Популярное (TMDB)
                            </a>
                        </li>
                        
                        <li class="nav-item">
                            <a class="nav-link text-light-50" asp-area="" asp-controller="Movie" asp-action="MyMovies">Мой Прокат</a>
                        </li>
                    </ul>
                    
                    <div class="d-flex align-items-center text-white-50 small">
                        <span class="badge bg-success me-2">● MovieApi Online</span>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-4 mt-auto shadow-sm">
        <div class="container">
            <div class="row align-items-center justify-content-between text-center text-md-start">
                <div class="col-md-6 mb-2 mb-md-0">
                    <span>&copy; 2026 — <strong>StepCinema Microservices App</strong></span>
                </div>
                <div class="col-md-6 text-md-end">
                    <a class="text-decoration-none text-muted me-3" asp-area="" asp-controller="Home" asp-action="Privacy">Конфиденциальность</a>
                    <span class="text-secondary">| Powered by Marten & Refit</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>